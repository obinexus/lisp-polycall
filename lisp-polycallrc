# lisp-polycallrc - Common Lisp runtime overrides for libpolycall
#
# Grammar: the core's legacy key=value configuration grammar, exactly as
# `polycall config validate lisp-polycallrc` and polycall_ffi_run_config()
# read it (see polycall docs/BINDING_ABI.md). This binding introduces no keys
# and no parser of its own: LISP-POLYCALL:RUN-CONFIG passes this path to the
# core. Strict validation (run=1) rejects unknown keys and tls_enabled=true.

log_level=info
max_connections=1000
network_timeout=5000
tls_enabled=false
