{
  "name": "lisp-polycall",
  "version": "1.1.0",
  "description": "Common Lisp (CFFI) binding for the Polycall binding ABI v1 (libpolycall >= 1.1.0): config validation, RPC calls and peer nodes",
  "main": "index.js",
  "type": "commonjs",
  "files": [
    "index.js",
    "lisp-polycall.asd",
    "src/",
    "examples/",
    "tests/",
    "Makefile",
    "lisp-polycallrc",
    "polycall-binding.json",
    "README.md",
    "TODO.md",
    "LICENSE"
  ],
  "directories": {
    "lib": "src",
    "example": "examples",
    "test": "tests"
  },
  "scripts": {
    "test": "node tests/package.test.js && sh tests/run-real-core.sh",
    "test:package": "node tests/package.test.js",
    "test:lisp": "sh tests/run-real-core.sh",
    "prepack": "node tests/package.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/obinexus/lisp-polycall.git"
  },
  "keywords": [
    "polycall",
    "libpolycall",
    "common-lisp",
    "cffi",
    "asdf",
    "peer-to-peer"
  ],
  "author": "Nnamdi Michael Okpala <okpalan@protonmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/obinexus/lisp-polycall/issues"
  },
  "homepage": "https://github.com/obinexus/lisp-polycall#readme"
}
